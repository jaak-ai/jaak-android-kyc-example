<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Estado focalizado -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/jaak_input_background" />
            <stroke android:width="2dp" android:color="@color/jaak_input_border_focused" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    
    <!-- Estado normal -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/jaak_input_background" />
            <stroke android:width="1dp" android:color="@color/jaak_input_border" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>