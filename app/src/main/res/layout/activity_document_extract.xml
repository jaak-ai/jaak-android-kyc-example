                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/jaak_text_secondary"
                        android:layout_marginBottom="8dp"
                        tools:text="INE" />

                    <!-- Número -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Número:"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/jaak_text_primary"
                        android:layout_marginBottom="2dp" />
                    <TextView
                        android:id="@+id/tvDocumentNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/jaak_text_secondary"
                        android:layout_marginBottom="8dp"
                        tools:text="194108329" />

                    <!-- Número de identificación personal -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Número de identificación personal:"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/jaak_text_primary"
                        android:layout_marginBottom="2dp" />
                    <TextView
                        android:id="@+id/tvPersonalIdNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/jaak_text_secondary"
                        tools:text="ROVD990210MMCBSN07" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ========== SECCIÓN: Estados OCR ========== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEstadosOcr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/jaak_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Título -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Estados OCR"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/jaak_text_primary"
                        android:layout_marginBottom="12dp" />

                    <!-- RecyclerView para Estados OCR -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvEstadosOcr"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:itemCount="3" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ========== SECCIÓN: Fotos OCR ========== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/jaak_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Título -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Fotos OCR"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/jaak_text_primary"
                        android:layout_marginBottom="12dp" />

                    <!-- Foto OCR -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_gravity="center_horizontal"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp">

                        <ImageView
                            android:id="@+id/ivOcrPhoto"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:contentDescription="Foto OCR"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground" />

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
