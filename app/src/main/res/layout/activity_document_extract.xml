                            android:textStyle="bold"
                            android:textColor="@color/jaak_text_primary"
                            android:layout_marginBottom="12dp" />

                        <!-- Tiempo de procesamiento -->
                        <TextView
                            android:id="@+id/tvProcessingTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/jaak_text_secondary"
                            android:layout_marginBottom="16dp"
                            tools:text="Tiempo de procesamiento: N/A" />

                        <!-- Subtítulo: Datos personales -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Datos personales"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/jaak_text_primary"
                            android:layout_marginBottom="12dp" />

                        <!-- Nombre completo -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Nombre completo:"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/jaak_text_primary"
                            android:layout_marginBottom="2dp" />
                        <TextView
                            android:id="@+id/tvFullName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/jaak_text_secondary"
                            android:layout_marginBottom="8dp"
                            tools:text="DANIELA JUDITH ROBLES VASQUEZ" />

                        <!-- Nombre -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Nombre:"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/jaak_text_primary"
                            android:layout_marginBottom="2dp" />
                        <TextView
                            android:id="@+id/tvFirstName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/jaak_text_secondary"
                            android:layout_marginBottom="8dp"
                            tools:text="DANIELA" />

                        <!-- Segundo nombre -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Segundo nombre:"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/jaak_text_primary"
                            android:layout_marginBottom="2dp" />
                        <TextView
                            android:id="@+id/tvMiddleName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/jaak_text_secondary"
                            android:layout_marginBottom="8dp"
                            tools:text="JUDITH" />

                        <!-- Apellido materno -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Apellido materno:"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/jaak_text_primary"
                            android:layout_marginBottom="2dp" />
                        <TextView
                            android:id="@+id/tvMotherLastName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/jaak_text_secondary"
                            android:layout_marginBottom="8dp"
                            tools:text="VASQUEZ" />

                        <!-- Apellido paterno -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Apellido paterno:"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/jaak_text_primary"
                            android:layout_marginBottom="2dp" />
                        <TextView
                            android:id="@+id/tvFatherLastName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/jaak_text_secondary"
                            android:layout_marginBottom="8dp"
                            tools:text="ROBLES" />

                        <!-- Fecha de nacimiento -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Fecha de nacimiento:"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/jaak_text_primary"
                            android:layout_marginBottom="2dp" />
                        <TextView
                            android:id="@+id/tvBirthDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/jaak_text_secondary"
                            android:layout_marginBottom="8dp"
                            tools:text="10/02/1999" />

                        <!-- Lugar de nacimiento -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Lugar de nacimiento:"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/jaak_text_primary"
                            android:layout_marginBottom="2dp" />
                        <TextView
                            android:id="@+id/tvBirthPlace"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/jaak_text_secondary"
                            android:layout_marginBottom="8dp"
                            tools:text="-" />

                        <!-- Género -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Género:"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/jaak_text_primary"
                            android:layout_marginBottom="2dp" />
                        <TextView
                            android:id="@+id/tvGender"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/jaak_text_secondary"
                            android:layout_marginBottom="8dp"
                            tools:text="Femenino" />

                        <!-- Nacionalidad -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Nacionalidad:"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/jaak_text_primary"
                            android:layout_marginBottom="2dp" />
                        <TextView
                            android:id="@+id/tvNationality"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/jaak_text_secondary"
                            android:layout_marginBottom="8dp"
                            tools:text="MEXICAN" />

                        <!-- Estado civil -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Estado civil:"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/jaak_text_primary"
                            android:layout_marginBottom="2dp" />
                        <TextView
                            android:id="@+id/tvMaritalStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/jaak_text_secondary"
                            android:layout_marginBottom="8dp"
                            tools:text="-" />

                        <!-- OCR -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="OCR:"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/jaak_text_primary"
                            android:layout_marginBottom="2dp" />
                        <TextView
                            android:id="@+id/tvOcr"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/jaak_text_secondary"
                            android:layout_marginBottom="8dp"
                            tools:text="1327107379263" />

                        <!-- Año de registro -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Año de registro:"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/jaak_text_primary"
                            android:layout_marginBottom="2dp" />
                        <TextView
                            android:id="@+id/tvRegistrationYear"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/jaak_text_secondary"
                            android:layout_marginBottom="8dp"
                            tools:text="2016 01" />

                        <!-- RFC -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="RFC:"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/jaak_text_primary"
                            android:layout_marginBottom="2dp" />
                        <TextView
                            android:id="@+id/tvRfc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/jaak_text_secondary"
                            tools:text="ROVD990210L4A" />

                    </LinearLayout>

                </ScrollView>

            </com.google.android.material.card.MaterialCardView>

            <!-- ========== SECCIÓN: Domicilio ========== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/jaak_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Título -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Domicilio"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/jaak_text_primary"
                        android:layout_marginBottom="12dp" />

                    <!-- Dirección completa -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Dirección completa:"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/jaak_text_primary"
                        android:layout_marginBottom="2dp" />
                    <TextView
                        android:id="@+id/tvFullAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/jaak_text_secondary"
                        android:layout_marginBottom="8dp"
                        tools:text="AV CHAPULETEPEC 7 COL VISTA HERMOSA 55028 ECATEPEC DE MORELOS, MEX" />

                    <!-- Código postal -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Código postal:"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/jaak_text_primary"
                        android:layout_marginBottom="2dp" />
                    <TextView
                        android:id="@+id/tvPostalCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/jaak_text_secondary"
                        android:layout_marginBottom="8dp"
                        tools:text="55028" />

                    <!-- Ciudad -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ciudad:"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/jaak_text_primary"
                        android:layout_marginBottom="2dp" />
                    <TextView
                        android:id="@+id/tvCity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/jaak_text_secondary"
                        android:layout_marginBottom="8dp"
                        tools:text="ECATEPEC DE MORELOS" />

                    <!-- Número exterior -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Número exterior:"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/jaak_text_primary"
                        android:layout_marginBottom="2dp" />
                    <TextView
                        android:id="@+id/tvExteriorNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/jaak_text_secondary"
                        android:layout_marginBottom="8dp"
                        tools:text="7" />

                    <!-- Número interior -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Número interior:"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/jaak_text_primary"
                        android:layout_marginBottom="2dp" />
                    <TextView
                        android:id="@+id/tvInteriorNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/jaak_text_secondary"
                        android:layout_marginBottom="8dp"
                        tools:text="No proporcionado" />

                    <!-- Colonia -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Colonia:"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/jaak_text_primary"
                        android:layout_marginBottom="2dp" />
                    <TextView
                        android:id="@+id/tvNeighborhood"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/jaak_text_secondary"
                        android:layout_marginBottom="8dp"
                        tools:text="VISTA HERMOSA" />

                    <!-- Estado -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Estado:"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/jaak_text_primary"
                        android:layout_marginBottom="2dp" />
                    <TextView
                        android:id="@+id/tvState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/jaak_text_secondary"
                        android:layout_marginBottom="8dp"
                        tools:text="ESTADO DE MEXICO" />

                    <!-- Calle -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Calle:"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/jaak_text_primary"
                        android:layout_marginBottom="2dp" />
                    <TextView
                        android:id="@+id/tvStreet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/jaak_text_secondary"
                        tools:text="AVENIDA CHAPULETEPEC" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ========== SECCIÓN: Documento ========== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/jaak_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Título -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Documento"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/jaak_text_primary"
