<?xml version="1.0" encoding="utf-8"?>
<!-- Layout para tabla de calidad de imagen con 4 columnas -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="12dp"
    android:paddingHorizontal="8dp"
    android:background="@color/white">

    <!-- Columna 1: Propiedad -->
    <TextView
        android:id="@+id/tvProperty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:textSize="10sp"
        android:textColor="@color/jaak_text_primary"
        android:layout_marginEnd="8dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:breakStrategy="balanced"
        android:hyphenationFrequency="none"
        tools:text="Borrosidad" />

    <!-- Columna 2: Datos de imagen -->
    <TextView
        android:id="@+id/tvImageData"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:textSize="10sp"
        android:textColor="@color/jaak_text_secondary"
        android:layout_marginEnd="8dp"
        android:gravity="center"
        android:maxLines="3"
        android:ellipsize="end"
        android:breakStrategy="balanced"
        android:hyphenationFrequency="none"
        tools:text="0.83" />

    <!-- Columna 3: Datos esperados -->
    <TextView
        android:id="@+id/tvExpectedData"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.5"
        android:textSize="10sp"
        android:textColor="@color/jaak_text_secondary"
        android:layout_marginEnd="8dp"
        android:gravity="center"
        android:maxLines="3"
        android:ellipsize="end"
        android:breakStrategy="balanced"
        android:hyphenationFrequency="none"
        tools:text="Menor a 0.71" />

    <!-- Columna 4: Resultados (icono + texto) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/ivResultIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_check_small"
            android:contentDescription="Result icon"
            android:layout_marginBottom="4dp"
            app:tint="@color/jaak_success" />

        <TextView
            android:id="@+id/tvResultText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="8sp"
            android:textColor="@color/jaak_success"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:breakStrategy="balanced"
            android:hyphenationFrequency="none"
            tools:text="Correcto" />

    </LinearLayout>

</LinearLayout>
