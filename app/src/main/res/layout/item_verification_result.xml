<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="@color/jaak_surface">

    <!-- Propiedad -->
    <TextView
        android:id="@+id/tvProperty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="10sp"
        android:textColor="@color/jaak_text_primary"
        android:paddingEnd="8dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:breakStrategy="balanced"
        android:hyphenationFrequency="none"
        tools:text="Score" />

    <!-- Datos recibidos -->
    <TextView
        android:id="@+id/tvReceivedData"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="10sp"
        android:textColor="@color/jaak_text_secondary"
        android:gravity="center"
        android:paddingHorizontal="8dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:breakStrategy="balanced"
        android:hyphenationFrequency="none"
        tools:text="1" />

    <!-- Datos esperados -->
    <TextView
        android:id="@+id/tvExpectedData"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="10sp"
        android:textColor="@color/jaak_text_secondary"
        android:gravity="center"
        android:paddingHorizontal="8dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:breakStrategy="balanced"
        android:hyphenationFrequency="none"
        tools:text="Mayor a 1" />

    <!-- Resultado con ícono -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.8"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/ivResultIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_check_small"
            android:contentDescription="Resultado"
            android:layout_marginBottom="4dp"
            tools:tint="@color/jaak_success" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="8sp"
            android:textColor="@color/jaak_success"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:breakStrategy="balanced"
            android:hyphenationFrequency="none"
            tools:text="Correcto" />

    </LinearLayout>

</LinearLayout>
