<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp">

    <TextView
        android:id="@+id/tvProperty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="13sp"
        android:textColor="@color/jaak_text_primary"
        tools:text="Evaluación - Lados Completos del Documento" />

    <TextView
        android:id="@+id/tvValueHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textSize="13sp"
        android:textColor="@color/jaak_text_primary"
        android:visibility="gone"
        android:text="Valor" />

    <ImageView
        android:id="@+id/ivValue"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:contentDescription="Estado"
        android:src="@drawable/ic_check_small"
        tools:tint="@color/jaak_success" />

</LinearLayout>
