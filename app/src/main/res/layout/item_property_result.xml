<?xml version="1.0" encoding="utf-8"?>
<!-- Layout para filas de propiedades con resultado (ej: Gafas - No detectado) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="8dp"
    android:paddingHorizontal="4dp">

    <TextView
        android:id="@+id/tvProperty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="11sp"
        android:textColor="@color/jaak_text_primary"
        android:maxLines="2"
        android:ellipsize="end"
        android:breakStrategy="balanced"
        android:hyphenationFrequency="none"
        tools:text="Gafas" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/ivResultIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_check_small"
            android:contentDescription="Result icon"
            android:layout_marginBottom="4dp"
            app:tint="@color/jaak_success"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="9sp"
            android:textColor="@color/jaak_success"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:breakStrategy="balanced"
            android:hyphenationFrequency="none"
            tools:text="No detectado" />

    </LinearLayout>

</LinearLayout>
