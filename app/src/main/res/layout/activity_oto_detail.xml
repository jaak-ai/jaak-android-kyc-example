<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jaak_background">

    <!-- AppBar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/jaak_surface">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/jaak_surface"
            app:title="Comparación 1:1"
            app:titleTextColor="@color/jaak_text_primary"
            app:navigationIcon="@drawable/ic_arrow_back" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Content - UNA SOLA COLUMNA -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ========== SECCIÓN: Imágenes ========== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/jaak_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Imágenes"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/jaak_text_primary"
                        android:layout_marginBottom="16dp" />

                    <!-- Grid de 2 imágenes -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <!-- Imagen 1 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Imagen 1"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/jaak_text_primary"
                                android:layout_marginBottom="8dp" />

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="match_parent"
                                android:layout_height="180dp"
                                app:cardCornerRadius="8dp"
                                app:cardElevation="2dp">

                                <ImageView
                                    android:id="@+id/ivImage1"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:contentDescription="Imagen 1"
                                    tools:src="@drawable/ic_person" />

                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>

                        <!-- Imagen 2 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Imagen 2"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/jaak_text_primary"
                                android:layout_marginBottom="8dp" />

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="match_parent"
                                android:layout_height="180dp"
                                app:cardCornerRadius="8dp"
                                app:cardElevation="2dp">

                                <ImageView
                                    android:id="@+id/ivImage2"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:contentDescription="Imagen 2"
                                    tools:src="@drawable/ic_person" />

                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ========== SECCIÓN: Accesorios faciales ========== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/jaak_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Accesorios faciales"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/jaak_text_primary"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvProcessingTimeAccessories"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/jaak_text_secondary"
                        android:layout_marginBottom="12dp"
                        tools:text="Tiempo de procesamiento: 167.2940 milisegundos" />

                    <!-- Imagen 1 -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Imagen 1"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/jaak_text_primary"
                        android:layout_marginBottom="8dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvAccessoriesImage1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:layout_marginBottom="12dp"
                        tools:itemCount="4" />

                    <!-- Imagen 2 -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Imagen 2"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/jaak_text_primary"
                        android:layout_marginBottom="8dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvAccessoriesImage2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:itemCount="4" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ========== SECCIÓN: Calidad de imagen - Imagen 1 ========== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/jaak_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Calidad de imagen"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/jaak_text_primary"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Imagen 1"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/jaak_text_primary"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvProcessingTimeQuality1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/jaak_text_secondary"
                        android:layout_marginBottom="12dp"
                        tools:text="Tiempo de procesamiento: 68 milisegundos" />

                    <!-- Header de tabla -->
                    <include layout="@layout/header_image_quality" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvQualityImage1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:itemCount="8" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ========== SECCIÓN: Calidad de imagen - Imagen 2 ========== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/jaak_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Imagen 2"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/jaak_text_primary"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvProcessingTimeQuality2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/jaak_text_secondary"
                        android:layout_marginBottom="12dp"
                        tools:text="Tiempo de procesamiento: 68 milisegundos" />

                    <!-- Header de tabla -->
                    <include layout="@layout/header_image_quality" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvQualityImage2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:itemCount="8" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ========== SECCIÓN: Comparación 1:1 ========== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/jaak_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Comparación 1:1"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/jaak_text_primary"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvProcessingTimeComparison"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/jaak_text_secondary"
                        android:layout_marginBottom="12dp"
                        tools:text="Tiempo de procesamiento: 417.90 milisegundos" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvComparison"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:itemCount="2" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Loading indicator -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="@style/JaakProgressBar.Medium"
        android:layout_gravity="center"
        android:visibility="gone"
        tools:visibility="visible" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
