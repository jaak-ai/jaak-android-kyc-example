<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/viewContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jaak_background"
    android:padding="24dp"
    tools:context="com.jaak.kyc.ui.view.MenuMainActivity">

    <!-- Logo con fondo azul y icono de llave -->
    <FrameLayout
        android:id="@+id/logoContainer"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/bg_logo_blue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/textViewTitle"
        app:layout_constraintVertical_chainStyle="packed">

        <ImageView
            android:id="@+id/ivJaak"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_key_white" />

    </FrameLayout>

    <!-- Título JAAK KYC -->
    <TextView
        android:id="@+id/textViewTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/onboarding_digital"
        android:textColor="@color/jaak_text_primary"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logoContainer"
        app:layout_constraintBottom_toTopOf="@+id/textViewSubtitle" />

    <!-- Subtítulo Verificación de Identidad -->
    <TextView
        android:id="@+id/textViewSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/descrip_init"
        android:textColor="@color/jaak_text_secondary"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewTitle"
        app:layout_constraintBottom_toTopOf="@+id/labelCodigoAcceso" />

    <!-- Label CÓDIGO DE ACCESO -->
    <TextView
        android:id="@+id/labelCodigoAcceso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="@string/codigo_acceso_label"
        android:textColor="@color/jaak_text_blue"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/etShort"
        app:layout_constraintTop_toBottomOf="@+id/textViewSubtitle" />

    <!-- Campo de entrada del código -->
    <EditText
        android:id="@+id/etShort"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input_field"
        android:gravity="center"
        android:hint=""
        android:inputType="textNoSuggestions"
        android:maxLength="7"
        android:textColor="@color/jaak_text_primary"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/labelCodigoAcceso"
        app:layout_constraintBottom_toTopOf="@+id/tvBtnStart" />

    <!-- Botón Continuar con flecha -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/tvBtnStart"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_button_continue"
        android:backgroundTint="@null"
        android:drawableEnd="@drawable/ic_arrow_forward"
        android:drawablePadding="16dp"
        android:enabled="false"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:stateListAnimator="@null"
        android:text="@string/btn_enter"
        android:textColor="@color/button_text_color"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etShort" />

    <!-- Texto "¿Tienes una cuenta?" -->
    <TextView
        android:id="@+id/tvHaveAccount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/have_account"
        android:textColor="@color/jaak_text_secondary"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvBtnStart" />

    <!-- Botón Iniciar Sesión -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="@android:color/transparent"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:text="@string/login_button_shortkey"
        android:textColor="@color/jaak_text_blue"
        android:textSize="14sp"
        android:textStyle="bold"
        app:icon="@drawable/ic_person"
        app:iconGravity="start"
        app:iconPadding="8dp"
        app:iconTint="@color/jaak_text_blue"
        app:rippleColor="@color/jaak_primary"
        app:strokeColor="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvHaveAccount" />

    <!-- Overlay de progreso (loading) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clProgress"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ProgressBar
            android:id="@+id/loading"
            style="@style/JaakProgressBar.Large"
            android:background="@color/orange"
            android:backgroundTint="@android:color/transparent"
            android:visibility="visible"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvLoadingText"
            style="@style/TextViewCenterTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="24dp"
            android:text="@string/init_session"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/loading" />


    </androidx.constraintlayout.widget.ConstraintLayout>



</androidx.constraintlayout.widget.ConstraintLayout>