<?xml version="1.0" encoding="utf-8"?>
<manifest
    android:versionCode="1"
    android:versionName="1.0"
    package="com.jaak.kyc"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="com.jaak.jaakrostrosandroid.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <permission
        android:name="com.jaak.kyc.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <uses-sdk android:minSdkVersion="22"
        android:targetSdkVersion="33"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:replace="android:maxSdkVersion"
        android:maxSdkVersion="28"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-feature android:name="android.hardware.camera.any" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:name="com.jaak.kyc.KYCApp"
        android:icon="@mipmap/ic_launcher"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.JaakAccessKeyless"
        tools:targetApi="p"
        tools:remove="android:dataExtractionRules,android:fullBackupContent"
        tools:replace="android:name">

        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />

        <!-- Deshabilitar inicialización automática de WorkManager -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
        <service
            android:name="androidx.room.MultiInstanceInvalidationService"
            tools:node="remove" />
        <meta-data android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.jaak.kyc.provider"
            android:exported="false"
            android:grantUriPermissions="true"
            tools:replace="android:authorities">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <activity android:name="com.jaak.kyc.ui.view.MenuMainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="com.jaak.kyc.ui.view.LoginActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"/>
        <activity android:name="com.jaak.kyc.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"/>
        <activity android:name="com.jaak.kyc.ui.view.SecurityPermissionsActivity"
            android:exported="true"
            android:screenOrientation="portrait"/>
        <activity android:name="com.jaak.kyc.ui.view.InitProcessLivenessActivity"
            android:exported="true"
            android:screenOrientation="portrait"/>
        <activity android:name="com.jaak.kyc.ui.view.VerifyOcrDocumentActivity"
            android:exported="true"
            android:screenOrientation="portrait"/>
        <activity android:name="com.jaak.kyc.ui.view.ErrorProcessActivity"
            android:exported="true"
            android:screenOrientation="portrait"/>
        <activity android:name="com.jaak.kyc.ui.view.FacialVerificationInstructionsActivity"
            android:exported="true"
            android:screenOrientation="portrait"/>
        <activity android:name="com.jaak.kyc.ui.view.SuccessDocumentActivity"
            android:exported="true"
            android:screenOrientation="portrait"/>
        <activity android:name="com.jaak.kyc.ui.view.FinalSuccessActivity"
            android:exported="true"
            android:screenOrientation="portrait"/>
        <activity android:name="com.jaak.kyc.ui.view.KycProcessesActivity"
            android:exported="true"
            android:screenOrientation="portrait"/>
        <activity android:name="com.jaak.kyc.ui.view.KycSyncActivity"
            android:exported="true"
            android:screenOrientation="portrait"/>
        <activity android:name="com.jaak.kyc.ui.view.DocumentVerificationInstructionsActivity"
            android:exported="true"
            android:screenOrientation="portrait"/>
        <activity android:name="com.jaak.kyc.ui.view.EditSessionProfileActivity"
            android:exported="false"
            android:screenOrientation="portrait"/>
        <activity android:name="com.jaak.kyc.ui.view.SessionDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait"/>
        <activity android:name="com.jaak.kyc.ui.view.BlacklistDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait"/>
        <activity android:name="com.jaak.kyc.ui.view.OtoDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait"/>
        <activity android:name="com.jaak.kyc.ui.view.LivenessDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait"/>
        <activity android:name="com.jaak.kyc.ui.view.DocumentDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait"/>
        <activity android:name="com.jaak.kyc.ui.view.DocumentExtractActivity"
            android:exported="false"
            android:screenOrientation="portrait"/>
        <activity android:name="com.jaak.kyc.ui.view.ProfilesListActivity"
            android:exported="false"
            android:screenOrientation="portrait"/>

        <!-- Bloquear actividad LAUNCHER del Visage SDK que causa íconos duplicados -->
        <activity
            android:name="com.jaak.visagesdk.ui.view.InitialFormActivity"
            tools:node="remove"/>

        <!-- Notification Action Receivers -->
        <receiver android:name="com.jaak.kyc.notification.NotificationActionReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver android:name="com.jaak.kyc.notification.DailySummaryReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver android:name="com.jaak.kyc.notification.ConnectivityReminderReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver android:name="com.jaak.kyc.notification.ErrorReminderReceiver"
            android:enabled="true"
            android:exported="false" />


    </application>
</manifest>